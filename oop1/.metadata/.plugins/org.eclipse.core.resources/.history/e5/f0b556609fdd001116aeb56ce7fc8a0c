import java.awt.Color;
import java.awt.Graphics;
import java.awt.Image;
import java.awt.event.MouseEvent;
import java.awt.event.MouseListener;

import javax.sound.sampled.Clip;
import javax.swing.JPanel;


public class Person extends JPanel implements MouseListener {
	private static final long serialVersionUID = 495174231483061663L;
	
	private String name = ""; 
	private String vorname = ""; 
	private boolean paintFlag = false;
	private boolean isJavaHater = false; 
	
	private Image Bild; 
	
	public Person(String vorname, String name){
		this.name = name; 
		this.vorname = vorname; 
	}
	
	public Person(String vorname, String name, String bildDatei) {
		this.name = name; 
		this.vorname = vorname; 
		
		this.Bild = Utility.loadResourceImage(bildDatei); 
		
		addMouseListener(this);
	}
	
	@Override
	public void paintComponent(Graphics g) {
		super.paintComponent(g); 
		
		// 
	    if (paintFlag == true) {
	        g.setColor(Color.PINK);
	    } else if( isJavaHater == true){
	    	g.setColor(Color.GREEN);
	    	g.drawString("Java Hater!", 20, 60);
	    } else {
	        g.setColor(Color.LIGHT_GRAY);
	    }
	    g.fillRect(5, 5, 205, 340);

	    // Draw Frame
	    g.setColor(Color.BLACK);
	    g.drawRect(5, 5, 205, 340);

	    // Draw the names
	    g.drawString(vorname, 20, 20);
	    g.drawString(name, 20, 40);

	    // Draw the image 
	    if (Bild != null) {
	        g.drawImage(Bild, 20, 50, null);
	    }
	}
	
	public void mousePressed(MouseEvent e) {
	    paintFlag = true;

	    repaint();
	}
	
	public void mouseReleased(MouseEvent e) {
	    paintFlag = false;
	    
	    repaint();
	}
	
	public void mouseClicked(MouseEvent e) {
		if(this.vorname.equals("Ambros") == true){
			isJavaHater = true; 
		} else {
			isJavaHater = false; 
		}
	}
	
	public void mouseEntered(MouseEvent e) {
	
	}

	public void mouseExited(MouseEvent e) {
	
	}

}