import java.awt.Graphics;
import java.awt.Image;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.awt.event.MouseEvent;
import java.awt.event.MouseListener;

public class Ballon {
	private TraceV7 trace = new TraceV7(this);
	private int x, y, d;
	private Image bild;

	public Ballon( ) {
		this(250, 80, 50, "image_2.png"); 
		
		System.out.println("Objekt initalisiert mit Standard Konstruktor."); 
	}
	
	public Ballon(int x, int y, int d) {
		trace.constructorCall();
		// 1. Konstruktor ergaenzen
		this.x = x; 
		this.y = y; 
		this.d = d; 
		
		bild = Utility.loadResourceImage("image_1.png"); 
		
		System.out.println("Objekt " + this + " hat die Attribute: " + "x=" + x + ", y=" + y + ", d=" + d);
		
	}
	
	public Ballon(int x, int y, int d, String name) {
		trace.constructorCall();
		// 1. Konstruktor ergaenzen
		this.x = x; 
		this.y = y; 
		this.d = d; 
		
		bild = Utility.loadResourceImage(name); 
		
		System.out.println("Objekt " + this + " hat die Attribute: " + "x=" + x + ", y=" + y + ", d=" + d);
		
	}	

	public void anzeigen(Graphics g) {
		trace.methodeCall();
		g.drawImage(bild, x - d / 2, y - d / 2, d, d, null);
	}

	//2. Methode groesseVeraendern(int v) anlegen

	
	public void groesseVeraendern( int v ) {
		this.d += v; 
	}

	private double flaeche( ) {
		return Math.PI * Math.pow(this.d/2, 2); 
	}
	
	public boolean equals(Ballon b) {
		return (b.flaeche() == this.flaeche())
	}
}
